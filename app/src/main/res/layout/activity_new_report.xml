<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".NewReportActivity">

    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="28dp">

            <com.example.reportu.DropdownField
                android:id="@+id/dropCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:dropHint="@string/hint_category"
                app:dropLabel="@string/label_category" />

            <com.example.reportu.LabeledInput
                android:id="@+id/inputDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:inputHint="@string/hint_description"
                app:inputKind="multiline"
                app:inputLabel="@string/label_description"
                app:inputMaxLength="300" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/label_photo"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/boxAddPhoto"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_upload_dashed"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_outline_light"
                    android:contentDescription="@null"
                    android:padding="11dp"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/ink" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/photo_add"
                    android:textColor="@color/ink"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/photo_hint"
                    android:textColor="@color/muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/boxPhotoPreview"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_photo_preview"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.ReportU.Rounded4" />

                <ImageButton
                    android:id="@+id/btnRemovePhoto"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_remove_photo"
                    android:contentDescription="@string/cd_remove_photo"
                    android:padding="8dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/white" />
            </FrameLayout>

            <com.example.reportu.LabeledInput
                android:id="@+id/inputLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:inputHint="@string/hint_location"
                app:inputKind="text"
                app:inputLabel="@string/label_place"
                app:inputMaxLength="80" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnGps"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_light"
                    android:drawableStart="@drawable/ic_location"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/ink"
                    android:paddingHorizontal="12dp"
                    android:text="@string/btn_gps"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnQr"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_light"
                    android:drawableStart="@drawable/ic_qr"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/ink"
                    android:paddingHorizontal="12dp"
                    android:text="@string/btn_scan_qr"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    android:textSize="11sp" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_black"
                android:text="@string/btn_submit_report"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
