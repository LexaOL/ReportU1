<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="LabeledInput">
        <attr name="inputLabel" format="string" />
        <attr name="inputHint" format="string" />
        <attr name="inputHelper" format="string" />
        <attr name="inputMaxLength" format="integer" />
        <attr name="inputToggle" format="boolean" />
        <attr name="inputKind" format="enum">
            <enum name="text" value="0" />
            <enum name="email" value="1" />
            <enum name="password" value="2" />
            <enum name="multiline" value="3" />
            <enum name="name" value="4" />
            <enum name="code" value="5" />
        </attr>
    </declare-styleable>

    <declare-styleable name="DropdownField">
        <attr name="dropLabel" format="string" />
        <attr name="dropHint" format="string" />
        <attr name="dropCompact" format="boolean" />
    </declare-styleable>
</resources>
